relay.simulationapi.com {
    root * /root/relay-server/hosted/viewer/dist

    # Root serves landing page
    redir / /landing.html

    # API and WebSocket proxy to Bun (must come before try_files)
    reverse_proxy /api/* localhost:8080
    reverse_proxy /publish localhost:8080
    reverse_proxy /view localhost:8080
    reverse_proxy /tap/* localhost:8080
    reverse_proxy /sessions localhost:8080
    reverse_proxy /stats localhost:8080
    reverse_proxy /gallery/api localhost:8080
    reverse_proxy /latest/* localhost:8080
    reverse_proxy /session/*/thumbnail localhost:8080
    reverse_proxy /session/*/video.mp4 localhost:8080
    reverse_proxy /session/*/export localhost:8080
    reverse_proxy /session/*/share localhost:8080
    reverse_proxy /session/*/share/* localhost:8080
    reverse_proxy /session/*/shares localhost:8080
    reverse_proxy /session/*/access localhost:8080
    reverse_proxy /session/*/audio-in localhost:8080
    reverse_proxy /session/*/video/* localhost:8080
    reverse_proxy /session/*/audio/* localhost:8080

    # Static files + SPA fallback (only for paths not matched above)
    file_server
    try_files {path} /index.html
}
