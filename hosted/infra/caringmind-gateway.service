[Unit]
Description=CaringMind Auth Gateway
After=network.target caringmind-relay.service
Requires=caringmind-relay.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/relay-server/hosted/gateway
EnvironmentFile=/root/relay-server/hosted/server/.env
Environment=BUN_INSTALL=/root/.bun
Environment=PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GATEWAY_PORT=3000
Environment=RELAY_TRUST_HEADERS=1
Environment=VIEWER_DIST=/root/relay-server/hosted/viewer/dist
ExecStart=/root/.bun/bin/bun run src/index.ts
Restart=always
RestartSec=5
StandardOutput=append:/var/log/caringmind-gateway.log
StandardError=append:/var/log/caringmind-gateway.log

[Install]
WantedBy=multi-user.target
